# Copy to .env, then fill in your own credentials locally.
# Historical verification used this model; availability depends on your account.
GENERATION_BASE_URL=https://api.openai.com/v1
GENERATION_MODEL=gpt-6.1-sol
GENERATION_API_KEY=

# Must match the frozen release. Changing the model requires a new corpus build.
EMBEDDING_PROVIDER=openai
EMBEDDING_BASE_URL=https://api.openai.com/v1
EMBEDDING_MODEL=text-embedding-3-large
EMBEDDING_DIMENSIONS=3072
EMBEDDING_API_KEY=

# Fill a local PostgreSQL DSN. Supply a password through PGPASSWORD or .pgpass.
RAG_CONVERSATION_DATABASE_URL=host=127.0.0.1 port=5432 dbname=rag_demo user=rag_demo
RAG_CONVERSATION_TOKEN=
RAG_CONVERSATION_RELEASE_PATH=data/corpus_releases/deploy_faults_20261102_v1/release_openai-embedding-20261105T113923Z_3caf7a.json
